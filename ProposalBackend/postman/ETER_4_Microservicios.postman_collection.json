							"host": [
								"{{activosUrl}}"
							],
							"path": [
								"api",
								"v1",
								"activos",
								"activos-fijos"
							]
						},
						"description": "Genera una placa nueva en cada ejecución y emite ACTIVO_CREADO en eter.activos.eventos.v1.",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nitUniv\": \"{{nitUniv}}\",\n  \"placaInventario\": \"{{placaKafka}}\",\n  \"descripcion\": \"Portátil Dell Latitude 5450 (flujo Kafka)\",\n  \"codUnspsc\": \"43211503\",\n  \"codSede\": \"SED-01\",\n  \"valorContable\": 3900000,\n  \"estado\": \"ACTIVO\"\n}"
						}
					},
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.collectionVariables.set('placaKafka', 'AF-PM-' + String(Date.now()).slice(-8));"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('201 Created', () => pm.response.to.have.status(201));"
								]
							}
						}
					]
				},
				{
					"name": "2. Kardex del activo (ALTA)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{inventarioUrl}}/api/v1/activos/movimientos-inventario?nitUniv={{nitUniv}}&placaInventario={{placaKafka}}",
							"host": [
								"{{inventarioUrl}}"
							],
							"path": [
								"api",
								"v1",
								"activos",
								"movimientos-inventario"
							],
							"query": [
								{
									"key": "nitUniv",
									"value": "{{nitUniv}}"
								},
								{
									"key": "placaInventario",
									"value": "{{placaKafka}}"
								}
							]
						},
						"description": "Lo registró el consumidor de inventario al recibir el evento. Si aún no aparece ALTA, espere 5 s y repita."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const tipos = pm.response.json().map(m => m.tipoMovimiento);",
									"pm.test('El kardex tiene ALTA (registrado por Kafka)', () => pm.expect(tipos).to.include('ALTA'));",
									"pm.test('Sin movimientos duplicados', () => pm.expect(new Set(tipos).size).to.eql(tipos.length));"
								]
							}
						}
					]
				},
				{
					"name": "3. Crear préstamo vencido del activo",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{prestamosUrl}}/api/v1/activos/prestamos",
							"host": [
								"{{prestamosUrl}}"
							],
							"path": [
								"api",
								"v1",
								"activos",
								"prestamos"
							]
						},
						"description": "Emite PRESTAMO_CREADO. Como la fecha pactada ya pasó, el vigía emitirá PRESTAMO_VENCIDO en ~30 s.",
