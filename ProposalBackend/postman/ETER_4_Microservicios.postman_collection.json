		{
			"name": "6. Flujo Kafka (Entrega 2P2)",
			"description": "Ejecutar en orden. Cada request de verificación tiene tests que comprueban que el evento fue consumido.",
			"item": [
				{
					"name": "1. Crear activo para el flujo Kafka",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
